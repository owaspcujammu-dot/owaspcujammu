# ---------------------------------------------------------------------------
# Public site URL — used for canonical + Open Graph tags and sitemap.xml
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://owaspcuj.vercel.app

# ---------------------------------------------------------------------------
# Contact form delivery (server-side only, never exposed to the browser).
# Pick ONE of the two options below.
#
# Option A — Formspree (easiest):
#   1. Create a free form at https://formspree.io
#   2. Copy the endpoint it gives you (looks like https://formspree.io/f/abcdwxyz)
# ---------------------------------------------------------------------------
FORMSPREE_ENDPOINT=

# ---------------------------------------------------------------------------
# Option B — Web3Forms (also free, no account needed for basic use):
#   1. Get an access key at https://web3forms.com
# ---------------------------------------------------------------------------
WEB3FORMS_ACCESS_KEY=

# If NEITHER is set, /api/contact runs in "dry-run" mode: it validates the
# submission and logs it to the server console so you can test locally.
